{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@google/adk": ["./core/src/index.ts"],
      "@google/adk/*": ["./core/src/*"],
      "@google/adk-integrations": ["./integrations/src/index.ts"],
      "@google/adk-integrations/*": ["./integrations/src/*"],
      "@google/adk-devtools": ["./dev/src/index.ts"],
      "@google/adk-devtools/*": ["./dev/src/*"]
    }
  },
  // This program checks sources only. Consumers are type-checked against the
  // emitted declarations by tests/integration/build_setup/build_setup_test.ts,
  // which runs `tsc` inside each ts_* fixture below (they depend on the built
  // packages via `file:` links) and runs in CI as part of `npm run
  // test:coverage`. Aliasing those fixtures to src would defeat their purpose.
  "exclude": [
    "node_modules",
    "**/dist",
    "tests/integration/build_setup/ts_commonjs",
    "tests/integration/build_setup/ts_esm",
    "tests/integration/build_setup/ts_commonjs_native_addon",
    "tests/integration/build_setup/ts_esm_native_addon"
  ]
}
