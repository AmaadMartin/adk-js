{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@google/adk": ["./core/src/index.ts"],
      "@google/adk/*": ["./core/src/*"],
      "@google/adk-devtools": ["./dev/src/index.ts"],
      "@google/adk-integrations": ["./integrations/src/index.ts"]
    }
  },
  // Entries below still carry pre-existing type errors and are each tracked by
  // separate follow-up work; the list is expected to shrink to the first three.
  // `exclude` only drops root files, not files reached through an import, so a
  // module that anything checked imports has to be fixed rather than listed.
  "exclude": [
    "node_modules",
    "**/dist",
    "core/test",
    "tests/integration/tools/agent_tool_vertexai_test.ts",
    "tests/integration/tools/skills_registry_integration_test.ts"
  ]
}
