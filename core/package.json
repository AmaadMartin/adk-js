{
  "name": "@google/adk",
  "version": "2.0.0",
  "description": "Google ADK JS",
  "author": "Google",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/adk-js"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "typings": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/web/index_web.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/web/index_web.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./dist/web/*": {
      "types": "./dist/types/*",
      "default": "./dist/web/*"
    },
    "./a2a": {
      "types": "./dist/types/a2a/index.d.ts",
      "import": "./dist/esm/a2a/index.js",
      "require": "./dist/cjs/a2a/index.js",
      "default": "./dist/esm/a2a/index.js"
    },
    "./artifacts/gcs": {
      "types": "./dist/types/artifacts/gcs_artifact_service.d.ts",
      "import": "./dist/esm/artifacts/gcs_artifact_service.js",
      "require": "./dist/cjs/artifacts/gcs_artifact_service.js",
      "default": "./dist/esm/artifacts/gcs_artifact_service.js"
    },
    "./integrations/firestore": {
      "types": "./dist/types/integrations/firestore/firestore_session_service.d.ts",
      "import": "./dist/esm/integrations/firestore/firestore_session_service.js",
      "require": "./dist/cjs/integrations/firestore/firestore_session_service.js",
      "default": "./dist/esm/integrations/firestore/firestore_session_service.js"
    },
    "./plugins/bigquery": {
      "types": "./dist/types/plugins/bigquery_agent_analytics_plugin.d.ts",
      "import": "./dist/esm/plugins/bigquery_agent_analytics_plugin.js",
      "require": "./dist/cjs/plugins/bigquery_agent_analytics_plugin.js",
      "default": "./dist/esm/plugins/bigquery_agent_analytics_plugin.js"
    },
    "./sessions/database": {
      "types": "./dist/types/sessions/database_session_service.d.ts",
      "import": "./dist/esm/sessions/database_session_service.js",
      "require": "./dist/cjs/sessions/database_session_service.js",
      "default": "./dist/esm/sessions/database_session_service.js"
    },
    "./sessions/migration": {
      "types": "./dist/types/sessions/migration/migrate_from_sqlalchemy_pickle.d.ts",
      "import": "./dist/esm/sessions/migration/migrate_from_sqlalchemy_pickle.js",
      "require": "./dist/cjs/sessions/migration/migrate_from_sqlalchemy_pickle.js",
      "default": "./dist/esm/sessions/migration/migrate_from_sqlalchemy_pickle.js"
    },
    "./telemetry/gcp": {
      "types": "./dist/types/telemetry/google_cloud.d.ts",
      "import": "./dist/esm/telemetry/google_cloud.js",
      "require": "./dist/cjs/telemetry/google_cloud.js",
      "default": "./dist/esm/telemetry/google_cloud.js"
    },
    "./tools/agent_simulator/agent_simulator_config": {
      "types": "./dist/types/tools/agent_simulator/agent_simulator_config.d.ts",
      "import": "./dist/esm/tools/agent_simulator/agent_simulator_config.js",
      "require": "./dist/cjs/tools/agent_simulator/agent_simulator_config.js",
      "default": "./dist/esm/tools/agent_simulator/agent_simulator_config.js"
    },
    "./tools/bigtable": {
      "types": "./dist/types/tools/bigtable/index.d.ts",
      "import": "./dist/esm/tools/bigtable/index.js",
      "require": "./dist/cjs/tools/bigtable/index.js",
      "default": "./dist/esm/tools/bigtable/index.js"
    },
    "./tools/crewai_tool": {
      "types": "./dist/types/tools/crewai_tool.d.ts",
      "import": "./dist/esm/tools/crewai_tool.js",
      "require": "./dist/cjs/tools/crewai_tool.js",
      "default": "./dist/esm/tools/crewai_tool.js"
    },
    "./tools/langchain_tool": {
      "types": "./dist/types/tools/langchain_tool.d.ts",
      "import": "./dist/esm/tools/langchain_tool.js",
      "require": "./dist/cjs/tools/langchain_tool.js",
      "default": "./dist/esm/tools/langchain_tool.js"
    },
    "./tools/mcp": {
      "types": "./dist/types/tools/mcp/index.d.ts",
      "import": "./dist/esm/tools/mcp/index.js",
      "require": "./dist/cjs/tools/mcp/index.js",
      "default": "./dist/esm/tools/mcp/index.js"
    },
    "./tools/spanner": {
      "types": "./dist/types/tools/spanner/index.d.ts",
      "import": "./dist/esm/tools/spanner/index.js",
      "require": "./dist/cjs/tools/spanner/index.js",
      "default": "./dist/esm/tools/spanner/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "clean:all": "npm run clean && rm -rf node_modules",
    "rebuild": "npm run clean:all && npm install && npm run build",
    "build": "tsc --emitDeclarationOnly && node ./build.js",
    "build:bundle": "tsc --emitDeclarationOnly && node ./build.js --bundle",
    "build:watch": "concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"node ./build.js --watch\"",
    "test": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
